{
  "name": "discord-challenge-bot",
  "version": "0.1.0",
  "description": "A Discord bot for daily challenges, progress tracking, and leaderboards",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"next dev\" \"ts-node src/bot/index.ts\"",
    "dev:web": "next dev",
    "dev:bot": "ts-node src/bot/index.ts",
    "build": "next build && tsc --project tsconfig.bot.json",
    "start": "node dist/bot/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "register": "ts-node src/scripts/register-commands.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "discord.js": "^13.17.1",
    "dotenv": "^17.0.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.30",
    "node-cron": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "prisma": "^7.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
