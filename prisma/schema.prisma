generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(cuid())
  discordId            String        @unique
  username             String
  avatar               String?
  notificationsEnabled Boolean       @default(false)
  createdAt            DateTime      @default(now())
  activityLogs         ActivityLog[]
  servers              ServerUser[]
}

model Server {
  id          String       @id @default(cuid())
  guildId     String       @unique
  name        String
  channelId   String?
  channelName String?
  createdAt   DateTime     @default(now())
  challenges  Challenge[]
  users       ServerUser[]
}

model ServerUser {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  server    Server   @relation(fields: [serverId], references: [id])
  serverId  String
  joinedAt  DateTime @default(now())

  @@unique([userId, serverId])
}

model Challenge {
  id        String   @id @default(cuid())
  type      String   @default("pushup") // pushup | situp | pullup | any
  name      String   @default("Push-ups")
  active    Boolean  @default(true)
  server    Server   @relation(fields: [serverId], references: [id])
  serverId  String
  createdAt DateTime @default(now())
}

// Records what a user actually did — one row per user per activity type per day
model ActivityLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String   // "pushup", "situp", "pullup", "walking", etc.
  count     Int
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, type, date])
}
