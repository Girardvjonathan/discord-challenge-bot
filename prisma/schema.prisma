generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(cuid())
  discordId            String        @unique
  username             String
  avatar               String?
  notificationsEnabled Boolean       @default(false)
  createdAt            DateTime      @default(now())
  activityLogs         ActivityLog[]
  channels             ChannelUser[]
}

// One record per Discord guild. Tracks which channel the challenge runs in
// and the active challenge configuration (flattened from former Challenge model).
model Channel {
  id              String        @id @default(cuid())
  guildId         String        @unique
  name            String
  channelId       String?       // Discord channel ID where results are posted
  channelName     String?
  challengeType   String?       // pushup | situp | pullup | any | other
  challengeName   String?       // display name; required when challengeType = "other"
  challengeActive Boolean       @default(false)
  createdAt       DateTime      @default(now())
  users           ChannelUser[]
}

model ChannelUser {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  channel   Channel  @relation(fields: [channelId], references: [id])
  channelId String
  joinedAt  DateTime @default(now())

  @@unique([userId, channelId])
}

// Records what a user actually did — one row per user per activity type per day
model ActivityLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String   // "pushup", "situp", "pullup", "walking", etc.
  count     Int
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, type, date])
}
